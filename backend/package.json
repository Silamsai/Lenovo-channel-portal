{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:all": "concurrently -n backend,client -c red,blue \"tsx watch src/index.ts\" \"npm run dev --prefix ../client\"",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "admin:create": "tsx src/db/create-admin.ts"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "pg": "^8.23.1",
    "pptxgenjs": "^4.0.1",
    "zod": "^3.25.76"
  },
  "description": "Channel Studio API: Node.js + TypeScript, plain SQL on PostgreSQL (Neon) with the pg driver."
}
