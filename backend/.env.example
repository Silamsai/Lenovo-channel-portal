# Copy to .env and change values.
PORT=4000
# PostgreSQL connection string from the Neon console (Connection details), e.g.
# DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=
# Long random string. Required in production.
JWT_SECRET="change-me-to-a-long-random-string"
# The Next.js app origin (it calls this API from its server).
CLIENT_ORIGIN="http://localhost:3000"
NODE_ENV=development
